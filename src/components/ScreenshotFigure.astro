---
interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  href?: string;
}

const { src, width, height, alt, caption, href } = Astro.props;
---

<figure class="screenshot-figure">
  {
    href ? (
      <a href={href} target="_blank" rel="noreferrer">
        <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
        <span class="sr-only"> (full size, opens in a new tab)</span>
      </a>
    ) : (
      <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
    )
  }
  <figcaption>{caption}</figcaption>
</figure>
