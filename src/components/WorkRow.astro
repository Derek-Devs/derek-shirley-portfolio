---
import type { CollectionEntry } from "astro:content";
import { workHref, workIsExternal } from "../lib/site";

interface Props {
  item: CollectionEntry<"work">;
  headingLevel?: "h2" | "h3";
}

const { item, headingLevel = "h3" } = Astro.props;
const href = workHref(item.data);
const external = workIsExternal(item.data);
const Heading = headingLevel;
---

<article class="work-row">
  <p class="meta work-row__context">
    {item.data.organization}
    <span class="work-row__kind">
      {item.data.status === "in-development" ? "In development" : "Professional work"}
    </span>
  </p>
  <div>
    <Heading>
      {
        href ? (
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer" : undefined}
          >
            {item.data.title}
            {external ? <span class="sr-only"> (opens in a new tab)</span> : null}
          </a>
        ) : (
          item.data.title
        )
      }
    </Heading>
    <p class="work-row__problem">{item.data.summary}</p>
  </div>
  <p class="work-row__result">{item.data.impact}</p>
</article>
