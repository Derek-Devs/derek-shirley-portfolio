---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkRow from "../../components/WorkRow.astro";

const work = await getCollection("work");
const professional = work
  .filter((item) => item.data.kind === "professional")
  .sort((a, b) => a.data.order - b.data.order);
const independent = work
  .filter((item) => item.data.kind === "independent")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Attribution, enrollment forecasting, marketing investment planning, and pricing analytics by Derek Shirley, with methods and decision outcomes."
>
  <div class="site-shell home-page">
    <section class="page-intro" aria-labelledby="work-title">
      <p class="section-label">Work</p>
      <h1 id="work-title">Selected work</h1>
      <p class="page-intro__dek">
        Projects from my work at Lark Health, Dave &amp; Buster’s, and American
        Diamond Logistics. The case studies describe what I built and how
        the teams used it.
      </p>
    </section>

    <section class="content-section" aria-labelledby="professional-work-title">
      <h2 class="section-label" id="professional-work-title">
        Professional work
      </h2>
      <div class="work-list">
        {
          professional.map((item) => (
            <WorkRow item={item} />
          ))
        }
      </div>
    </section>

    <section
      class="content-section"
      id="independent-research"
      aria-labelledby="independent-work-title"
    >
      <h2 class="section-label" id="independent-work-title">
        Independent research
      </h2>
      <p class="section-lede">
        I’m studying airport disruption forecasts alongside marketing
        incrementality and budget allocation. These projects show the work as it develops.
      </p>
      <div class="work-list">
        {
          independent.map((item) => (
            <WorkRow item={item} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
