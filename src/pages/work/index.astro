---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkRow from "../../components/WorkRow.astro";

// Drafts keep their source files but are not listed.
const work = await getCollection("work", ({ data }) => !data.draft);
const professional = work
  .filter((item) => item.data.kind === "professional")
  .sort((a, b) => a.data.order - b.data.order);
const independent = work
  .filter((item) => item.data.kind === "independent")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Derek Shirley’s work in marketing attribution, enrollment forecasting, budget planning and pricing analytics, with the results each one produced."
>
  <div class="site-shell home-page">
    <section class="page-intro" aria-labelledby="work-title">
      <p class="section-label">Work</p>
      <h1 id="work-title">Selected work</h1>
      <p class="page-intro__dek">
        What I built at Lark Health, Dave &amp; Buster’s and American Diamond
        Logistics, and how teams used it.
      </p>
    </section>

    <section class="content-section" aria-labelledby="professional-work-title">
      <h2 class="section-label" id="professional-work-title">
        Professional work
      </h2>
      <div class="work-list">
        {
          professional.map((item) => (
            <WorkRow item={item} />
          ))
        }
      </div>
    </section>

    <section
      class="content-section"
      id="independent-research"
      aria-labelledby="independent-work-title"
    >
      <h2 class="section-label" id="independent-work-title">
        Independent projects and research
      </h2>
      <p class="section-lede">
        Projects I build on my own. Fellstrike shows a full analytics stack,
        from event tracking to an AI agent, on simulated data. The airport
        study asks how much warning weather forecasts give about delays and
        cancellations, and shows the work as it develops.
      </p>
      <div class="work-list">
        {
          independent.map((item) => (
            <WorkRow item={item} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
