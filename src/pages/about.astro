---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateRange } from "../lib/site";

const roles = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="About"
  description="Derek Shirley’s experience in marketing measurement, analytics engineering and AI-assisted analytics, from Lark Health and Dave & Buster’s to supply chain and pricing analytics."
>
  <div class="site-shell home-page">
    <section class="page-intro" aria-labelledby="about-title">
      <p class="section-label">About</p>
      <h1 id="about-title">Derek Shirley</h1>
      <div class="reading-column prose-copy page-intro__dek">
        <p>
          I build the measurement marketing and growth teams use to decide
          where budget goes: attribution, marketing mix models, experiments
          and forecasts, plus the governed dbt and Snowflake models underneath
          them.
        </p>
        <p>
          I started in art sales and gallery management in 2017. I later
          established the pricing analytics department at American Diamond
          Logistics, then worked in supply-chain analytics at GameStop and
          marketing analytics at Dave &amp; Buster’s. From November 2025 to
          November 2026, I led marketing analytics, attribution and
          measurement for partner programs and direct-to-consumer growth at
          Lark Health, an AI health coaching company.
        </p>
        <p>
          At Lark, I rebuilt marketing attribution across web, paid media,
          direct mail, partner and enrollment channels in governed
          Snowflake/dbt models and built the measurement layer for the Samsung
          Health partnership launch. At Dave &amp;
          Buster’s, a media-contribution model I built on a three-hour deadline
          gave the CEO and CMO a $6.9M Q4 recommendation against an outside
          proposal of about $11M.
        </p>
        <p>
          I’ve managed sales teams at Park West and selected and trained an
          analyst at American Diamond Logistics. At Dave &amp; Buster’s, I helped
          select the analyst hired into Marketing and trained the new hire.
          I’ve also coached logistics coordinators at American Diamond
          Logistics and fellow analysts at GameStop.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="about-experience-title">
      <h2 class="section-label" id="about-experience-title">Experience</h2>
      <ol class="chronology">
        {
          roles.map((role) => (
            <li>
              <div>
                <a href={`/experience#${role.id}`}>
                  {role.data.organization.split(" (")[0]}
                </a>
                <p class="meta">{role.data.title}</p>
              </div>
              <p class="chronology__meta">
                {formatDateRange(role.data.start, role.data.end)}
              </p>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href="/experience">Full experience</a>
    </section>

    <section class="content-section">
      <p>
        <a class="text-link" href="/work">Selected work</a>
      </p>
    </section>
  </div>
</BaseLayout>
