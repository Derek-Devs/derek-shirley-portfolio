---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateRange } from "../lib/site";

const roles = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="About"
  description="Derek Shirley builds measurement systems for growth decisions in decision science, growth analytics, and data systems."
>
  <div class="site-shell home-page">
    <section class="page-intro" aria-labelledby="about-title">
      <p class="section-label">About</p>
      <h1 id="about-title">Derek Shirley</h1>
      <div class="reading-column prose-copy page-intro__dek">
        <p>
          I build the measurement behind growth decisions. The sequence is
          trustworthy data, then evidence, then a decision, then a system that
          can run that decision again.
        </p>
        <p>
          I have worked in analytics since 2017 across digital health,
          marketing, retail supply chain, logistics, and sales. Current work
          sits in decision science, growth, and data systems, including
          attribution, lifecycle measurement, and the production models behind
          them.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="about-experience-title">
      <h2 class="section-label" id="about-experience-title">Experience</h2>
      <ol class="chronology">
        {
          roles.map((role) => (
            <li>
              <div>
                <a href={`/experience#${role.id}`}>
                  {role.data.organization.split(" (")[0]}
                </a>
                <p class="meta">{role.data.title}</p>
              </div>
              <p class="chronology__meta">
                {formatDateRange(role.data.start, role.data.end)}
              </p>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href="/experience">Full experience</a>
    </section>

    <section class="content-section">
      <p>
        <a class="text-link" href="/work">Selected work</a>
      </p>
    </section>
  </div>
</BaseLayout>
