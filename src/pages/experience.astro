---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceRole from "../components/ExperienceRole.astro";

const roles = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Experience"
  description="Derek Shirley's experience in decision science, growth measurement, analytics engineering, and data systems."
>
  <section class="page-intro" aria-labelledby="experience-title">
    <div class="site-shell">
      <div class="reading-column">
        <p class="section-label">Experience</p>
        <h1 id="experience-title">Experience</h1>
        <p class="page-intro__dek">
          I have worked in analytics since 2017 across digital health,
          marketing, retail supply chain, logistics, and sales. Current work
          sits in decision science, growth, and data systems.
        </p>
      </div>
    </div>
  </section>

  <div class="site-shell">
    <div class="experience-list">
      {roles.map((role) => <ExperienceRole role={role} />)}
    </div>
  </div>
</BaseLayout>
