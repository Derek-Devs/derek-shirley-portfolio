---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceRole from "../components/ExperienceRole.astro";
import { site } from "../lib/site";

const roles = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Experience"
  description="Derek Shirley’s work history in marketing analytics, retail supply chain, freight pricing, and sales management."
>
  <section class="page-intro" aria-labelledby="experience-title">
    <div class="site-shell">
      <div class="reading-column">
        <p class="section-label">Experience</p>
        <h1 id="experience-title">Experience</h1>
        <p class="page-intro__dek">
          I’ve worked in analytics and commercial operations since 2017,
          starting in art sales and gallery management. I now lead marketing
          analytics at Lark Health.
        </p>
        <a class="text-link" href={site.resume} download>Download résumé (PDF, one page)</a>
      </div>
    </div>
  </section>

  <div class="site-shell">
    <div class="experience-list">
      {roles.map((role) => <ExperienceRole role={role} />)}
    </div>
  </div>
</BaseLayout>
