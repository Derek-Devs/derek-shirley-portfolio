---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkRow from "../components/WorkRow.astro";
import { formatDateRange, site } from "../lib/site";

const featuredWork = (await getCollection("work"))
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const roles = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout home>
  <div class="site-shell home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <p class="meta home-hero__identity">{site.name}</p>
      <h1 id="home-title">I build the measurement behind growth decisions.</h1>
      <p class="home-hero__dek">
        I design data systems, causal measurement, and experimentation for
        marketing and growth teams. The job is to see what is working, decide
        what to fund, and run those decisions in production.
      </p>
      <p class="home-hero__specialties">
        Decision Science · Growth · Data Systems
      </p>
      <p class="home-hero__actions">
        <a href="#selected-work">Selected Work</a>
        <a href={site.github} target="_blank" rel="noreferrer">
          GitHub
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a href="/experience">Experience</a>
      </p>
    </section>

    <dl class="metric-row" aria-label="Selected outcomes">
      <div>
        <dt>42% → 8%</dt>
        <dd>
          Unknown enrollment attribution at Lark Health after the production
          rebuild, on a trailing 365-day view.
        </dd>
      </div>
      <div>
        <dt>$6.9M vs $11M</dt>
        <dd>
          Q4 media recommendation at Dave &amp; Buster’s versus an outside
          consultancy proposal.
        </dd>
      </div>
      <div>
        <dt>43% · 22%</dt>
        <dd>
          Faster pricing response and higher win rate at American Diamond
          Logistics, during a period of 26% annual revenue growth.
        </dd>
      </div>
    </dl>

    <section
      class="content-section"
      id="selected-work"
      aria-labelledby="selected-work-title"
    >
      <h2 class="section-label" id="selected-work-title">01 / Selected work</h2>
      <div class="work-list">
        {
          featuredWork.map((item, index) => (
            <WorkRow item={item} index={index} />
          ))
        }
      </div>
      <a class="text-link" href="/work">All work</a>
    </section>

    <section class="content-section" aria-labelledby="current-research-title">
      <h2 class="section-label" id="current-research-title">
        02 / Current research
      </h2>
      <div class="research-block">
        <p class="meta">In development</p>
        <h2>Growth incrementality and allocation</h2>
        <p>
          Estimating which growth investments create incremental value, and
          where the next dollar should go when the answer is uncertain.
        </p>
        <a class="text-link" href="/work#independent-research">Independent research</a>
      </div>
    </section>

    <section class="content-section" aria-labelledby="career-chronology-title">
      <h2 class="section-label" id="career-chronology-title">03 / Experience</h2>
      <ol class="chronology">
        {
          roles.map((role) => (
            <li>
              <div>
                <a href={`/experience#${role.id}`}>
                  {role.data.organization.split(" (")[0]}
                </a>
                <p class="meta">{role.data.title}</p>
              </div>
              <p class="chronology__meta">
                {formatDateRange(role.data.start, role.data.end)}
              </p>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href="/experience">Full experience</a>
    </section>
  </div>
</BaseLayout>
